# Copie para .env e preencha. O .env não vai para o Git.

# Credencial da API da Anthropic (ou use `ant auth login`, que dispensa esta linha)
ANTHROPIC_API_KEY=

# Modelo de todos os agentes
METAEXP_MODEL=claude-opus-5-5

# Esforço de raciocínio por uso: low | medium | high | xhigh | max
METAEXP_EFFORT_CHAT=medium
METAEXP_EFFORT_BENCH=high
METAEXP_EFFORT_SYNTH=medium

# 1 = quando um classificador de segurança recusar, o servidor tenta outro modelo
METAEXP_FALLBACKS=1

# Onde ficam os documentos reais e o corpus (padrões abaixo)
# METAEXP_REAL_DOCS=data/real
# METAEXP_CORPUS_DIRS=data/corpus/real:data/corpus/sintetico
