# Copie para .env e preencha. O .env não vai para o Git.

# Chave da API do LiteLLM (ou do proxy compatível configurado)
ANTHROPIC_API_KEY=

# URL base do proxy LiteLLM, se estiver usando um endpoint próprio
# Ex.: http://localhost:4000/v1
ANTHROPIC_BASE_URL=

# 0 = desativa validação TLS do proxy (útil quando o certificado não é confiável)
ANTHROPIC_VERIFY_SSL=1

# Modelo de todos os agentes
METAEXP_MODEL=deepseek-v4-flash

# Esforço de raciocínio por uso: low | medium | high | xhigh | max
METAEXP_EFFORT_CHAT=medium
METAEXP_EFFORT_BENCH=high
METAEXP_EFFORT_SYNTH=medium

# 1 = quando um classificador de segurança recusar, o servidor tenta outro modelo
METAEXP_FALLBACKS=1

# Onde ficam os documentos reais e o corpus (padrões abaixo)
# METAEXP_REAL_DOCS=data/real
# METAEXP_CORPUS_DIRS=data/corpus/real:data/corpus/sintetico

# 1 = toda ficha encaminhada espera a revisão do Lab (gate G0); 0 = aprova ao encaminhar
METAEXP_REVISAO_LAB=1

# Onde ficam as sessões (SQLite) e o app compilado
# METAEXP_SESSIONS_DIR=data/sessions
# METAEXP_FRONTEND_DIR=web/dist
